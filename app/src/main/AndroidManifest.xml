<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 权限清单：正式功能不含任何定位 SDK、不读取任何坐标（硬性规则 3）。
         ACCESS_FINE_LOCATION：**主链路必需**（v4 读 CellInfo 的平台校验门槛，Android 10+ 起强制）——
         仅用于读取小区标识（pci:ci），不是定位；主链路活性检测与运行时授权见 cell-zone-detector-v4。
         ACCESS_COARSE_LOCATION 与 ACTIVITY_RECOGNITION 是 lab-data-collection（短期调试数据采集）
         的临时例外，仅供实验室采集旁路服务使用；采集需求下线时随 lab 一并移除。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- cellular-wifi-fingerprint-validate（Wi-Fi 指纹采集，仍属 lab 临时例外）：
         扫描结果仅做 BSSID 哈希指纹、不做定位 → neverForLocation；
         CHANGE_WIFI_STATE 供 startScan 主动续扫（限频证据是假设 H4 的数据）。
         指纹裁决出结论后随本需求一并移除。
         ⚠️ 2026-09-30 结案：wifi 快照恒空与 neverForLocation / INTERNET 权限均无关
         （两者增删对照实验：LabWifiCollector WIFI_DIAG 显示 wifi_mgr 恒 false 而
         settings wifi_on=1，shell 扫描正常）→ HyperOS 4 beta 的 WifiManager 兼容层
         对第三方 App 异常/抑制，H1/H4 关闭，节后系统更新后凭 WIFI_DIAG 重验。 -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetroStop">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：specialUse（硬性规则 5，含 SUBTYPE 说明属性） -->
        <service
            android:name=".platform.service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="乘坐地铁时识别列车到站并提醒" />
        </service>

        <!-- QS 磁贴一键开始 -->
        <service
            android:name=".platform.qs.MonitorTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 实验室数据采集旁路服务（lab-data-collection，短期调试需求；
             与监测服务完全独立，采集需求下线时随权限一起移除） -->
        <service
            android:name=".platform.lab.LabCollectorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="调试用多传感器数据采集" />
        </service>

        <!-- 注意：通知按钮接收器 MonitorActionReceiver **不在此声明**，
             按硬性规则 6 在 MonitorService 内动态注册（RECEIVER_NOT_EXPORTED）。 -->
    </application>
</manifest>
